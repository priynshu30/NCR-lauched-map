# ── Client Environment Variables ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# All Vite env vars MUST start with VITE_ to be exposed to the browser.

# Backend API base URL (Express server)
# When running locally: http://localhost:5000
# In production: https://your-api-domain.com
VITE_API_URL=http://localhost:5000

# Optional: Mapbox token (if switching from Leaflet+OSM to Mapbox GL)
# VITE_MAPBOX_TOKEN=pk.xxxxxxxxxxxxxxxx
