# ── Server Environment Variables ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://localhost:27017/ncr_launchmap

# Port for Express server
PORT=5000

# CORS: comma-separated list of allowed origins
CLIENT_ORIGIN=http://localhost:5173

# ── Optional: Geocoding (Nominatim is free, no key needed) ────────────────────
# If you want OpenCage instead of Nominatim, add your key here:
# OPENCAGE_API_KEY=your_opencage_key_here

# ── Optional: Hirist / Cutshort API keys ─────────────────────────────────────
# HIRIST_API_KEY=
# CUTSHORT_API_KEY=

# ── Ingestion schedule (cron expression) ──────────────────────────────────────
# Default: every 6 hours  →  "0 */6 * * *"
INGEST_CRON=0 */6 * * *

# ── Rate limiting ──────────────────────────────────────────────────────────────
# Max requests per window (per IP)
RATE_LIMIT_MAX=100
# Window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
